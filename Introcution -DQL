--NOTE ; COMMANDS OR NAMES CAN BE TYPED IN UPPER /LOWER/MIXED CASE ALPHABETS 
---DQL (Data query Language) 
-- SELECT : SELECT is a SQL statement used to retrieve data from one or more tables. It allows us to select specific columns, filter results, perform calculations, use functions, and return the required data.
--SELECT * FROM TABLENAME


SELECT * FROM EMP
SELECT ENAME,EMPNO,JOB FROM EMP


--WHERE STATEMENT 
--IS USED TO APPLY FILTER ON SELECT STATMENT 
SELECT * FROM EMP WHERE DEPTNO=10
SELECT * FROM EMP WHERE JOB='MANAGER' AND DEPTNO=10
SELECT * FROM EMP WHERE JOB='SALESMAN' OR DEPTNO=10 OR DEPTNO=30
SELECT * FROM EMP WHERE JOB='ANALYST' 

--GET A LIST OF EMPLOYEES ANALYST
SELECT * FROM EMP WHERE JOB='ANALYST'

SELECT * FROM EMP WHERE SAL >=3000
SELECT * FROM EMP WHERE SAL >=1000 AND SAL >=3000

--DD-MMM-YYYY, MM/DD/YYYY ,MM-DD-YYYY,MM.DD.YYYY
--MMM MEANING MONTH IN TEXT FROMAT -- JAN ,FEB
--MM MEANING MONTH IN NUMBER FORMAT -01,04...

SELECT * FROM EMP WHERE HIREDATE ='01-MAY-1981'

SELECT * FROM EMP WHERE HIREDATE = '05/01/1981'



--wHERE STATEMENT USING OPERATORS 
--IN ,NOT IN 

SELECT * FROM EMP WHERE DEPTNO=10 OR DEPTNO=20
SELECT*FROM EMP WHERE DEPTNO IN(10,30)
SELECT*FROM EMP WHERE JOB IN ('ANALYST','MANAGER')

--NOT IN

SELECT * FROM EMP WHERE DEPTNO NOT IN(10,30)
SELECT * FROM EMP WHERE JOB NOT IN('ANALYST')

--BETWEEN ,NOT BETWEEN
SELECT * FROM EMP WHERE SAL BETWEEN 2000 AND 3000
SELECT * FROM EMP WHERE SAL NOT BETWEEN 3000 AND 4000

SELECT * FROM EMP WHERE HIREDATE BETWEEN '01/12/1981' AND '01/12/1981'

--IS NULL IS NOT NULL

SELECT * FROM EMP WHERE COMM IS NULL
SELECT * FROM EMP WHERE COMM IS NOT NULL

-- LIKE ,NOT LIKE 
-- TO FILTER THE TEXT VALUES STARTING WITH ,ENDS WITH ,CONATINS ,DOESNT CONTAINS 
SELECT * FROM EMP WHERE ENAME LIKE 'S%' -- ENAME STARTS WITH S,AFTER S THERE CAN BE ANY OF CHRS
SELECT * FROM EMP WHERE DEPT LIKE 'D%'

SELECT * FROM EMP WHERE ENAME LIKE '%R'  -- ENAME ENDS WITH R, BEFORE R THERE CAN BE ANY CHARS
SELECT * FROM EMP WHERE ENAME LIKE 'K%G'
SELECT * FROM EMP WHERE ENAME NOT LIKE 'A%'


--GROUP BY STATEMENT
--USED TO PREPARE SUMMARY REPORT /MIS REPORTS/CONSOLIDATION OF HUNDREDS

SELECT * FROM EMP
SELECT DEPTNO ,COUNT(*) AS ROWS_CNT FROM EMP GROUP BY DEPTNO
SELECT JOB ,COUNT(*) AS TOTAL_JOBS FROM EMP GROUP BY JOB

-- Group By 
-- SUMMARY REPORTS/
SELECT * FROM EMP
SELECT DEPTNO,COUNT(*) AS NO_OF_ROWS FROM EMP 
GROUP BY DEPTNO 

SELECT JOB ,COUNT(*) AS EMPLOYESS FROM EMP 
GROUP BY JOB

SELECT ENAME ,COUNT(*) AS NO_S FROM EMP WHERE ENAME LIKE 'S%' 
GROUP BY ENAME
--AGGREGATIONS FUNCTIONS
--COUNT(*),-- ROW COUNT ,SUM(COL_NAME0 ,MAX(COL_NAME),MIN(COL_NAME)

SELECT DEPTNO ,COUNT(*) AS R_CNT , SUM(SAL) AS TOTAL_SAL FROM EMP 
GROUP BY DEPTNO

--JOB WISE COUNT ROWS ,MAX OF SAL IN EACH JOB 
SELECT JOB ,COUNT(*) AS R_CNT ,MAX(SAL) AS MAX_SAL FROM EMP
GROUP BY JOB

--DEPTNO WISE AVG(SAL) FRO EACH DEPT NOT , MAX(SAL) IN EACH DEPTNO

SELECT DEPTNO , AVG(SAL) AS AVG_SAL ,MAX(SAL) AS MAX_SAL FROM EMP
GROUP BY DEPTNO


--ORDER BY (sORT THE COULMNS IN ASCENDING OR DESCENING ORDER)
SELECT * FROM EMP ORDER BY SAL DESC
SELECT* FROM EMP ORDER BY SAL ASC

--MULTI COULUMN GROUP BY
SELECT*  FROM EMP ORDER BY DEPTNO

SELECT DEPTNO,JOB ,COUNT(*) AS REC_CNT FROM EMP
GROUP BY DEPTNO,JOB
ORDER BY DEPTNO

SELECT DEPTNO ,JOB ,SUM(SAL) AS TOTAL_SAL FROM EMP
GROUP BY DEPTNO,JOB
ORDER BY DEPTNO

